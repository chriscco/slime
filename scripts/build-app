#!/bin/sh
# 组 .app bundle：swift build + 手工拼 build/slime.app。
#
# 为什么手工组：本机没有完整 Xcode，不走也不需要 Xcode 工程（CLAUDE.md 第五条）。
#
# 为什么 LSUIElement=true：无 Dock 图标、不出现在系统 ⌘Tab 列表里（spec §2 第 1 条）。
#
# Match Package.swift; macOS 15 uses the opaque background fallback.
#
# 签名（CLAUDE.md 第五条，不是可选项）：辅助功能权限认的是代码签名的
# designated requirement。优先用自签证书签 —— scripts/setup-signing 建过一次，
# 证书身份不变，rebuild 就不会掉权限；没有证书就退回 ad-hoc，
# 并且每次 rebuild 都要去系统设置里重新勾一遍辅助功能权限。
#
# 用法：
#   scripts/build-app                  # debug
#   CONFIG=release scripts/build-app   # release
set -eu

cd "$(dirname "$0")/.."

CONFIG=${CONFIG:-debug}
BUNDLE_ID=com.chriscco.slime
APP=build/slime.app

swift build -c "$CONFIG"

BIN=".build/$CONFIG/slime"
if [ ! -x "$BIN" ]; then
  echo "✗ 没找到可执行文件 $BIN" >&2
  exit 1
fi

rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp docs/assets/slime-banner.png "$APP/Contents/Resources/slime-banner.png"
cp Resources/slime.icns "$APP/Contents/Resources/slime.icns"
cp "$BIN" "$APP/Contents/MacOS/slime"

cat > "$APP/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>slime</string>
  <key>CFBundleIdentifier</key><string>$BUNDLE_ID</string>
  <key>CFBundleName</key><string>slime</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.0.8</string>
  <key>CFBundleVersion</key><string>8</string>
  <key>CFBundleIconFile</key><string>slime</string>
  <key>LSMinimumSystemVersion</key><string>15.0</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
EOF

# ditto preserves Sparkle's framework symlinks and helper executable modes.
framework="$APP/Contents/Frameworks/Sparkle.framework"
mkdir -p "$APP/Contents/Frameworks"
ditto .build/artifacts/sparkle/Sparkle/Sparkle.xcframework/macos-arm64_x86_64/Sparkle.framework "$framework"
python3 - "$APP/Contents/Info.plist" <<'PYTHON'
import os, plistlib, runpy, sys
updates = runpy.run_path('scripts/sign-updates')
key = os.environ.get('SPARKLE_PUBLIC_KEY', '')
if not key and os.environ.get('REQUIRE_UPDATES') == '1':
    sys.exit('SPARKLE_PUBLIC_KEY is required for release updates')
with open(sys.argv[1], 'rb') as source:
    info = plistlib.load(source)
info.update(SUEnableAutomaticChecks=False, SUAutomaticallyUpdate=False,
            SUAllowsAutomaticUpdates=False, SUSendProfileInfo=False,
            SURequireSignedFeed=True, SUVerifyUpdateBeforeExtraction=True)
if key:
    updates['public_key'](key)
    info.update(SUPublicEDKey=key, SUFeedURL=updates['FEED_URL'])
with open(sys.argv[1], 'wb') as output:
    plistlib.dump(info, output)
PYTHON

# 自签证书的 hash 从 keychain 里找（setup-signing 建的 CN = slime Local Signing）。
identity=${SIGNING_IDENTITY:-$(security find-identity -v -p codesigning 2>/dev/null \
  | sed -n 's/.*) \([0-9A-Fa-f]\{40\}\) "slime Local Signing".*/\1/p')}

if [ -z "$identity" ] && [ "${REQUIRE_SIGNING:-0}" = 1 ]; then
  echo "Release signing identity is required; refusing ad-hoc signing." >&2
  exit 1
fi
# Sign from the inside out; --deep is verification only, not a signing strategy.
for nested in "$framework/Versions/B/XPCServices/Downloader.xpc" \
              "$framework/Versions/B/XPCServices/Installer.xpc" \
              "$framework/Versions/B/Autoupdate" \
              "$framework/Versions/B/Updater.app" "$framework"; do
  codesign --force --sign "${identity:--}" "$nested"
done
if [ -n "$identity" ]; then
  codesign --force --sign "$identity" "$APP"
  echo "✓ ${APP}（自签证书，辅助功能权限可扛 rebuild）"
else
  codesign --force --sign - "$APP"
  echo "⚠ ${APP}（ad-hoc 签名：每次 rebuild 都要去系统设置里重新勾一遍辅助功能权限）"
  echo "  一次性解决：scripts/setup-signing"
fi

codesign --verify --deep --strict "$APP"
